// Bindgen configuration for Flecs.
// See https://github.com/karl-zylinski/odin-c-bindgen for the full list of options.

inputs = [
	"flecs/distr/flecs.h",
]

// Write the Odin package directly to the repository root, so users can `import flecs "path/to/odin-flecs"`.
output_folder = "."
imports_file = "bindgen/imports.odin"
package_name = "flecs"

// Generate against a release build of Flecs (no debug-only fields in structs).
// `bindgen_debug.sjson` is the matching debug config.
clang_defines = {
	"FLECS_NDEBUG" = "1",
}

procedures_at_end = true

// `ECS_SIZEOF(x)` is a function-like macro that the generator cannot expand. These two
// object-like macros are the only public macros that rely on it, and they are internal
// implementation details, so drop them from the bindings.
//
// The other entries below are macros that the generator translates into invalid Odin
// (untyped bitwise-not, C compound literals, values that overflow their cast). They are
// internal helpers that are not needed to call the C API, so they are dropped as well.
remove = [
	"FLECS_STACK_PAGE_OFFSET",
	"FLECS_STACK_PAGE_SIZE",
	"ECS_ROW_FLAGS_MASK",
	"ECS_COMPONENT_MASK",
	"ECS_STRBUF_INIT",
	"ECS_HTTP_REPLY_INIT",
	"ECS_MAX_COMPONENT_ID",
]
