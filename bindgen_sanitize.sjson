// Bindgen configuration for the sanitized (FLECS_SANITIZE) flavour of Flecs.
//
// This is only used by `scripts\generate.cmd` to collect the sanitize-only struct layouts, which
// are merged into `flecs.odin` behind `FLECS_SANITIZE`. See `bindgen.sjson` for comments.

inputs = [
	"flecs/distr/flecs.h",
]

output_folder = "build/flecs_sanitize"
imports_file = "bindgen/imports.odin"
package_name = "flecs"

// FLECS_SANITIZE implies FLECS_DEBUG and adds extra fields to a couple of structs.
clang_defines = {
	"FLECS_SANITIZE" = "1",
}

procedures_at_end = true

remove = [
	"FLECS_STACK_PAGE_OFFSET",
	"FLECS_STACK_PAGE_SIZE",
	"ECS_ROW_FLAGS_MASK",
	"ECS_COMPONENT_MASK",
	"ECS_STRBUF_INIT",
	"ECS_HTTP_REPLY_INIT",
	"ECS_MAX_COMPONENT_ID",
]
